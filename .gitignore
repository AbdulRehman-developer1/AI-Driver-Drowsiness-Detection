# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Audio cache & temporary session data
.audio_cache/
*.wav
*.mp3
!assets/*.wav
!assets/*.mp3

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Streamlit local configurations & secrets
.streamlit/secrets.toml

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Logs & temp files
*.log
*.tmp
tmp/

# Optional: MediaPipe model file (auto-downloaded on first run)
# face_landmarker.task
